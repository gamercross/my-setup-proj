<?xml version="1.0" encoding="UTF-8"?>
<!--
  하루 마지막 작업로그 정리 launchd 예약 작업. **참고용 템플릿이다.**

  ⚠️ 아래 경로는 이 저장소의 개발 머신 기준으로 하드코딩돼 있다. 다른 컴퓨터에서는
     이 파일을 직접 복사하지 말고 아래 스크립트로 설치한다 (경로 자동 생성):

       bash scripts/install-worklog-launchd.sh            # 설치/재설치
       bash scripts/install-worklog-launchd.sh --uninstall

  Ubuntu 는 launchd 가 없다 → cron:  50 23 * * * /경로/scripts/worklog-eod.sh
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.aicomputeros.worklog</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/jaeyeup/proj/my-setup-proj/my-setup-proj/scripts/worklog-eod.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/jaeyeup/proj/my-setup-proj/my-setup-proj</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>23</integer>
    <key>Minute</key>
    <integer>50</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/Users/jaeyeup/proj/my-setup-proj/my-setup-proj/scripts/worklog-eod.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/jaeyeup/proj/my-setup-proj/my-setup-proj/scripts/worklog-eod.log</string>
</dict>
</plist>
