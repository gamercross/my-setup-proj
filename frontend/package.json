{
  "name": "ai-computer-os-desktop",
  "version": "0.1.0",
  "description": "Personal productivity AI agent for Windows/Mac/Linux",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently -k \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:localhost:5173 && cross-env NODE_ENV=development electron . --enable-logging",
    "build": "vite build",
    "build:demo": "cross-env VITE_DEMO=1 vite build",
    "preview:demo": "cross-env VITE_DEMO=1 vite build && vite preview",
    "test": "node --test test/*.test.mjs",
    "package": "electron-builder"
  },
  "dependencies": {
    "mermaid": "11.17.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-grid-layout": "2.2.4",
    "react-resizable": "3.2.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^27.0.0",
    "vite": "^7.0.0",
    "wait-on": "^8.0.1"
  }
}
