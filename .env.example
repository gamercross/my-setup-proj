# 이 파일을 .env 로 복사해서 값을 채우세요:  cp .env.example .env

# Google APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Notion
NOTION_API_KEY=

# Slack (에이전트 진행 상황·일일 요약 알림용 Incoming Webhook)
# 발급: Slack → Apps → "Incoming Webhooks" → Add to Slack → 채널 선택 → URL 복사
SLACK_WEBHOOK_URL=

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# App Config
NODE_ENV=development
PORT=3000
