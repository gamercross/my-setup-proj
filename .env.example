# 이 파일을 .env 로 복사해서 값을 채우세요:  cp .env.example .env

# Google APIs (데스크톱 앱 OAuth 클라이언트 — Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI 는 데스크톱 loopback 흐름에서 미사용 (웹 흐름 도입 시에만 필요)
GOOGLE_REDIRECT_URI=

# OAuth 토큰 암호화 키 (Fernet, ADR-0024). 아래 명령으로 생성해 채우세요:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=
# 토큰 파일 경로 (선택, 비우면 agent/.secrets/google_token.enc)
GOOGLE_TOKEN_PATH=

# Notion
NOTION_API_KEY=
# 브리핑을 자식 페이지로 만들 부모 페이지 id (32자 hex, URL 끝부분).
# 해당 페이지 우상단 '...' → Connections → 위 integration 추가 필수.
NOTION_PARENT_PAGE_ID=

# Slack (에이전트 진행 상황·일일 요약 알림용 Incoming Webhook)
# 발급: Slack → Apps → "Incoming Webhooks" → Add to Slack → 채널 선택 → URL 복사
SLACK_WEBHOOK_URL=

# Claude API (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Supabase
SUPABASE_URL=
SUPABASE_KEY=

# App Config
NODE_ENV=development
PORT=3000

# 로컬 DB 경로 (비우면 backend/data/app.db — ADR-0009)
# Electron 패키지 실행 시 main.js 가 app.getPath('userData')/app.db 로 덮어씀
DATABASE_PATH=

# 일일 브리핑 예약 시각 (기본 07:30). 바꾸면 launchd 재설치 + 이 값을 함께 수정
DAILY_BRIEF_HOUR=
DAILY_BRIEF_MINUTE=

# agent/ 폴더 절대 경로 명시 (선택 — 패키지 배포·비표준 배치)
AGENT_PATH=
